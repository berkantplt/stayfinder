APP_NAME=turXtur
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_TIMEZONE=Europe/Istanbul
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# ÜRETİM: LOG_STACK=daily + LOG_LEVEL=warning kullanın — 'single' rotasyonsuz
# tek dosya + 'debug' seviyesi laravel.log'u sınırsız büyütür (LOG_DAILY_DAYS=14 hazır).

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# ScoreTourRubricJob timeout=300 sn — retry_after bundan BÜYÜK olmalı,
# yoksa kuyruk aynı işi ikinci worker'a verir ve LLM iki kez faturalanır.
DB_QUEUE_RETRY_AFTER=600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ZORUNLU: AI arama, chatbot, tur içe aktarma ve embedding job'ları OpenAI
# anahtarı olmadan exception ile çöker. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- AI özellik bayrakları ----
# ⚠️ ÜÇÜ DE VARSAYILAN false. Tanımlamazsanız ilgili özellik CANLIDA GÖRÜNMEZ.
# Daha önce tam bu yüzden aylarca kapalı kaldılar — bir özelliği açmayı
# planlıyorsanız burayı ve sunucudaki .env'i birlikte kontrol edin.
#
# v1 sohbet asistanı (dondurulmuş mimari, yerini v2 aldı)
AI_CHAT_ENABLED=false
# v2 sohbet asistanı (araç çağırma) — canlıya alınacak olan bu
AI_CHAT_V2_ENABLED=false
# Tur eşleştirme testi (/tatil-karakteri) — ana sayfadaki "Testi başlat" girişi.
# 2026-08-11'de askıya alındı; true yapınca giriş noktaları geri gelir.
AI_QUIZ_ENABLED=false
# AI Keşif Rehberi (/kesif-rehberi) — varsayılan AÇIK, kapatmak için false.
# AI_DISCOVERY_ENABLED=true
# AI_DISCOVERY_MODEL=gpt-5.4-mini

# Ana sayfa gezinme bloğu: filter | both | mega
# filter = yalnız filtre barı (VARSAYILAN)
# both   = mega menü (kategori ağacı) + filtre barı birlikte
# mega   = yalnız mega menü (filtre /turlar sayfasında durmaya devam eder)
# Hiçbir mod kod silmez; mega menü kodu yerinde, yalnız render edilmiyor.
HOME_NAV=filter

# Partner otel servisleri: gerçek partner API'si yoksa mock modda çalış (dev/test).
PARTNER_MOCK_ENABLED=true

# AI model konfigürasyonu (config/ai.php) — varsayılanlar mantıklı, sadece A/B
# testi veya maliyet kısıtı için override et.
# AI_INTENT_MODEL=gpt-4o
# AI_COMMENT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_DEST_MODEL=gpt-4o-mini
# AI_IMPORT_MODEL=gpt-5.4-mini
# Tur URL içe aktarma okuyucu servisi (boş = doğrudan fetch). Jina Reader key opsiyonel.
# AI_IMPORT_READER_URL=https://r.jina.ai/
# JINA_API_KEY=
# Derin tarama (tüm tarihler / dinamik içerik için) — firecrawl.dev'den ücretsiz key
# FIRECRAWL_API_KEY=

IYZICO_MODE=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Override base URI manually if needed (sandbox/production resolved automatically from IYZICO_MODE):
# IYZICO_BASE_URI=https://sandbox-api.iyzipay.com
IYZICO_CURRENCY=TRY
IYZICO_LOCALE=tr
